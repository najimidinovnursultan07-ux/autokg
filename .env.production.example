DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-output-of-secrets-token-urlsafe-command
DEBUG=False
ALLOWED_HOSTS=autokg.example.com

DB_ENGINE=django.db.backends.postgresql
DB_NAME=dbautokg
DB_USER=autokg
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=https://autokg-ten.vercel.app
CSRF_TRUSTED_ORIGINS=https://autokg-ten.vercel.app
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@autokg.example.com
PASSWORD_RESET_URL=https://autokg-ten.vercel.app/password-reset

HTTP_PORT=8080
GUNICORN_WORKERS=3
