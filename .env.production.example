DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-output-of-secrets-token-urlsafe-command
DEBUG=False
ALLOWED_HOSTS=autobuy.example.com

DB_ENGINE=django.db.backends.postgresql
DB_NAME=dbautobuy
DB_USER=autobuy
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=https://autobuy-kg.vercel.app
CSRF_TRUSTED_ORIGINS=https://autobuy-kg.vercel.app
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=None

# Brevo HTTP API (рекомендуется на Render: SMTP на free заблокирован). Если задан — EMAIL_* ниже не нужны
BREVO_API_KEY=

# ИИ-помощник на сайте (Google Gemini). Без ключа чат отвечает «временно недоступен».
GEMINI_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@autobuy.example.com
PASSWORD_RESET_URL=https://autobuy-kg.vercel.app/password-reset

HTTP_PORT=8080
GUNICORN_WORKERS=3

# Render: можно вместо DB_* указать одну строку подключения
DATABASE_URL=
SECURE_SSL_REDIRECT=True

# Cloudinary (только на бэкенде; API secret никогда не попадает во фронтенд)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Необязательно: create_admin создаст администратора при старте контейнера
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=

# Тарифы: уведомления администратору в Telegram (необязательно)
# Токен — у @BotFather, chat id — у @userinfobot (или id группы)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Отдельный бот (и чат) для кодов входа админа (2FA); пусто — используются два параметра выше
TELEGRAM_BOT_ADMIN_TOKEN=
TELEGRAM_ADMIN_2FA_CHAT_ID=

# Бот уведомлений покупателям (подписки на поиск, снижение цен). Имя бота узнаётся автоматически.
TELEGRAM_BOT_USER_TOKEN=
# Секрет для ежедневного запуска напоминаний: POST /api/internal/subscription-reminders/
CRON_SECRET=
