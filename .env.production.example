DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-output-of-secrets-token-urlsafe-command
DEBUG=False
ALLOWED_HOSTS=autobuy.example.com

DB_ENGINE=django.db.backends.postgresql
DB_NAME=dbautobuy
DB_USER=autobuy
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=https://autokg-ten.vercel.app
CSRF_TRUSTED_ORIGINS=https://autokg-ten.vercel.app
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@autobuy.example.com
PASSWORD_RESET_URL=https://autokg-ten.vercel.app/password-reset

HTTP_PORT=8080
GUNICORN_WORKERS=3

# Render: можно вместо DB_* указать одну строку подключения
DATABASE_URL=
SECURE_SSL_REDIRECT=True

# Supabase Storage — медиафайлы (только на бэкенде; service role key не попадает во фронтенд)
# Project Settings → API: URL и service_role key. Бакет создайте публичным (Storage → New bucket → Public).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=media

# Необязательно: create_admin создаст администратора при старте контейнера
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
