DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=local-development-only-change-before-deploying
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=autokg
DB_USER=autokg
DB_PASSWORD=local-only-change-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
POSTGRES_PUBLISH_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@autokg.local
PASSWORD_RESET_URL=http://localhost:5173/password-reset
